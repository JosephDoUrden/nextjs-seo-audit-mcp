{
  "name": "nextjs-seo-audit-mcp",
  "version": "0.1.2",
  "description": "Next.js SEO Audit: read-only MCP server (stdio) that audits a deployed site for SEO and indexing issues from an agent, built on vercel-seo-audit",
  "type": "module",
  "mcpName": "io.github.JosephDoUrden/nextjs-seo-audit",
  "bin": {
    "nextjs-seo-audit-mcp": "./bin/nextjs-seo-audit-mcp.js"
  },
  "files": [
    "dist",
    "bin",
    "server.json",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node bin/nextjs-seo-audit-mcp.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "seo",
    "audit",
    "vercel",
    "nextjs"
  ],
  "author": "JosephDoUrden",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JosephDoUrden/nextjs-seo-audit-mcp.git"
  },
  "homepage": "https://github.com/JosephDoUrden/nextjs-seo-audit-mcp#readme",
  "bugs": {
    "url": "https://github.com/JosephDoUrden/nextjs-seo-audit-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "vercel-seo-audit": "^2.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
